PPOCR_IMAGE=ghcr.io/lxw112190/lw.ppocr.opencvdnn:1.0.0
PPOCR_PORT=8787
PPOCR_API_KEY=
PPOCR_ENGINE_INSTANCES=1
PPOCR_WORKER_THREADS=4
PPOCR_MAX_QUEUED_REQUESTS=32
PPOCR_ENGINE_WAIT_TIMEOUT_MS=5000
PPOCR_MAX_BATCH_IMAGES=32
PPOCR_MAX_BATCH_TOTAL_PIXELS=40000000
PPOCR_MAX_BATCH_DECODED_BYTES=120000000
PPOCR_PDF_DPI=200
PPOCR_MAX_PDF_PAGES=10
PPOCR_MAX_PDF_PAGE_PIXELS=25000000
PPOCR_MAX_PDF_TOTAL_PIXELS=100000000
PPOCR_PDFIUM_LIBRARY=
# Comma-separated exact browser origins; empty disables CORS. Use * only when
# the service is intentionally public and no origin restriction is required.
PPOCR_CORS_ENABLED=false
PPOCR_CORS_ALLOWED_ORIGINS=
PPOCR_LOGGING_ENABLED=true
PPOCR_FILE_LOGGING_ENABLED=true
PPOCR_REQUEST_LOGGING_ENABLED=true
PPOCR_REQUEST_START_LOGGING_ENABLED=true
PPOCR_ACCESS_FILE_LOGGING_ENABLED=true
PPOCR_ACCESS_LOG_FORMAT=jsonl
PPOCR_LOG_FLUSH_INTERVAL_SECONDS=1
# Comma-separated exact proxy IPs allowed to supply X-Forwarded-For.
PPOCR_TRUSTED_PROXIES=
