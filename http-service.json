{
  "$schema": "schemas/http-service-config-v1.schema.json",
  "schema_version": 1,
  "listen_host": "127.0.0.1",
  "port": 8787,
  "model_manifest": "models/ppocrv6-tiny/model.json",
  "web_root": "www",
  "api_key": "",
  "enable_classifier": true,
  "limit_side_len": 960,
  "det_db_threshold": 0.3,
  "det_db_box_threshold": 0.6,
  "det_db_unclip_ratio": 1.6,
  "det_use_dilation": false,
  "cls_threshold": 0.9,
  "cls_batch_size": 8,
  "rec_batch_size": 8,
  "rec_concurrency": 1,
  "engine_instances": 1,
  "worker_threads": 4,
  "max_queued_requests": 32,
  "engine_wait_timeout_ms": 5000,
  "max_request_bytes": 20971520,
  "max_image_pixels": 40000000,
  "max_batch_images": 32,
  "max_batch_total_pixels": 40000000,
  "max_batch_decoded_bytes": 120000000,
  "pdf_dpi": 200,
  "max_pdf_pages": 10,
  "max_pdf_page_pixels": 25000000,
  "max_pdf_total_pixels": 100000000,
  "cors": {
    "enabled": false,
    "allowed_origins": []
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "console": true,
    "file_enabled": true,
    "file_path": "logs/runtime.log",
    "request_enabled": true,
    "request_start_enabled": true,
    "access_file_enabled": true,
    "access_file_path": "logs/access.log",
    "access_format": "jsonl",
    "flush_interval_seconds": 1,
    "trusted_proxies": [],
    "max_file_size_mb": 10,
    "max_files": 5
  }
}
